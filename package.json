{
  "name": "uchcharan",
  "version": "0.3.0",
  "description": "Make any TTS speak Indian text correctly. Normalizes ₹ amounts, lakh/crore, dates, times, phone numbers, PNR/OTP, %, units, UPI IDs, train and vehicle numbers and acronyms into spoken Hindi, Marathi and Indian English.",
  "type": "module",
  "main": "src/index.js",
  "exports": "./src/index.js",
  "bin": {
    "uchcharan": "bin/uchcharan.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node examples/demo.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "tts",
    "text-normalization",
    "hindi",
    "marathi",
    "indic",
    "voice-ai",
    "speech",
    "elevenlabs",
    "sarvam",
    "ivr"
  ],
  "license": "MIT",
  "homepage": "https://uchcharan.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/densa850-lab/uchcharan.git"
  },
  "funding": "https://github.com/sponsors/densa850-lab"
}
